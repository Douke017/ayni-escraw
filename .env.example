# ==============================================================================
# AYNI TRUST MARKETPLACE — Unified Environment Variables Configuration
# ==============================================================================
# Copia este archivo como .env en la raíz del proyecto y completa tus credenciales.
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. HSK Chain Testnet & Web3 Configuration
# ------------------------------------------------------------------------------
# HSK Chain Testnet RPC endpoint (L2 EVM Cancun, Chain ID: 133)
HSK_RPC_URL=https://testnet.hsk.xyz
CHAIN_ID=133
HSK_EXPLORER_URL=https://testnet-explorer.hskchain.net

# Clave privada de la cuenta con fondos HSK (faucet) para compilar y desplegar contratos
# Formato: Hexadecimal de 64 caracteres sin o con prefijo 0x
DEPLOYER_PRIVATE_KEY=

# Clave privada y dirección del Agente de Validación de IA (ERC-8004 Validator)
AGENT_PRIVATE_KEY=
AGENT_ADDRESS=

# Clave privada y dirección del Árbitro para resolución de disputas 2-de-3 multisig
ARBITRATOR_PRIVATE_KEY=
ARBITRATOR_ADDRESS=

# Dirección de la Tesorería receptora de pagos por suscripción Pro y retenciones
TREASURY_ADDRESS=

# Dirección del contrato de token USDT en HSK Testnet
# Si lo dejas vacío durante el deploy, se desplegará automáticamente AyniTestUSDT
USDT_TOKEN_ADDRESS=

# Dirección oficial de Uniswap Permit2 (Canónica o desplegada en HSK)
PERMIT2_ADDRESS=0x000000000022D473030F116dDEE9F6B43aC78BA3

# ------------------------------------------------------------------------------
# 2. Direcciones de Smart Contracts Desplegados (Generados tras ejecutar Deploy)
# ------------------------------------------------------------------------------
# Se completan automáticamente o a partir de contracts/deployed-contracts.json
AYNI_PASSPORT_ADDRESS=
AYNI_REGISTRY_ADDRESS=
AYNI_ESCROW_ADDRESS=
AYNI_SUBSCRIPTION_ADDRESS=
AYNI_CHAT_BOND_ADDRESS=

# ------------------------------------------------------------------------------
# 3. Google Gemini AI & Agent Configuration
# ------------------------------------------------------------------------------
# Tu API Key de Google Gemini (Google AI Studio / Vertex AI)
GEMINI_API_KEY=

# Modelo de Gemini para extracción de especificaciones y validación multimodal
GEMINI_MODEL=gemini-2.5-flash

# Desactivar modos mock para llamadas reales a Gemini y transacciones Web3
MOCK_LLM_MODE=false
WEB3_MOCK_MODE=false

# ------------------------------------------------------------------------------
# 4. Backend Core (.NET 9), Base de Datos & Almacenamiento
# ------------------------------------------------------------------------------
# Configuración de PostgreSQL 16
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=ayni_db
POSTGRES_USER=ayni_user
POSTGRES_PASSWORD=ayni_secure_pass_2026

# Cadena de conexión Redis 7 (con nonces TTL 60s para Safe Meet QR)
REDIS_CONNECTION=localhost:6379,abortConnect=false

# Almacenamiento de Objetos MinIO S3
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=ayni_minio_admin
MINIO_SECRET_KEY=ayni_minio_secret_pass_2026
MINIO_WITH_SSL=false

# Autenticación JWT para Backend y SignalR WebSockets
JWT_SECRET=Ayni_Super_Secret_Key_For_Jwt_Token_Authentication_2026_Minimum_32_Bytes_Long!
JWT_ISSUER=AyniBackend
JWT_AUDIENCE=AyniFrontend
JWT_EXPIRY_HOURS=24

# Entorno de ejecución de Python para llamadas programáticas a los agentes
PYTHON_PATH=/home/douke017/Personal/Ayni-Scrow/ai-agents/.venv/bin/python3
AI_AGENTS_RUNNER_PATH=/home/douke017/Personal/Ayni-Scrow/ai-agents/runner.py

# ------------------------------------------------------------------------------
# 5. Frontend (Angular 22) Client Configuration
# ------------------------------------------------------------------------------
API_BASE_URL=http://localhost:5000/api
SIGNALR_HUB_URL=http://localhost:5000
MINIO_PUBLIC_URL=http://localhost:9000
